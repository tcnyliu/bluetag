<%- include("partials/head") %>

<section class="narrow">
  <h1>My posts</h1>
  <p class="lede">Close a listing once the item is back with its person.</p>

  <% if (items.length === 0) { %>
    <p class="empty">You have not posted yet. <a href="/items/new">Add one</a>.</p>
  <% } else { %>
    <ul class="list">
      <% items.forEach((item) => { %>
        <li>
          <a href="/items/<%= item.id %>">
            <strong><%= item.title %></strong>
            <span class="pill <%= item.kind %>"><%= item.kind %></span>
            <span class="pill <%= item.status %>"><%= item.status %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<%- include("partials/foot") %>
